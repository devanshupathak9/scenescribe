# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/scenescribe

# Signs login tokens. In production: a random string of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret

# ── Production ────────────────────────────────────────────────────────────────
# NODE_ENV=production
# Allowed web origins, comma-separated. `*` matches one subdomain label, so this
# also covers Vercel preview deployments:
# CORS_ORIGIN=https://scenescribe.vercel.app,https://scenescribe-*-yourteam.vercel.app

# Real admin account. Created on first boot (password must be 12+ chars) and
# promoted to admin on every boot. The password is only used on creation...
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ...unless ADMIN_RESET_PASSWORD=true: then it overwrites the admin's password on
# boot. Use it for one deploy to recover access, then delete it.
# ADMIN_RESET_PASSWORD=false

# ── AI ────────────────────────────────────────────────────────────────────────
# Without a key the app still works: scores and debate reports are clearly
# labelled automatic estimates.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o            # scoring + debate reports
# OPENAI_FAST_MODEL=gpt-4o-mini  # live debate opponent (latency matters)

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Which calendar day counts as "today" for daily scenes and streaks.
APP_TIMEZONE=Asia/Kolkata

# Demo accounts abc@gmail.com / xyz@gmail.com (public passwords). Defaults to
# true locally and MUST be false in production (the server refuses to start).
# SEED_DEMO_ACCOUNTS=true

# Sequelize auto-migrates the schema on boot. Set false once you add migrations.
# DB_SYNC_ALTER=true
# DB_POOL_MAX=10
# DATABASE_SSL=          # auto: off for localhost/db, on for hosted databases

# ── Email / OTP ───────────────────────────────────────────────────────────────
# Leave blank locally: OTP codes are printed to the server console instead.
# For Gmail: enable 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SceneScribe <your-email@gmail.com>"

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# OAuth "Web application" client ID, e.g. 1234-abc.apps.googleusercontent.com.
# Same value as the web app's VITE_GOOGLE_CLIENT_ID. Empty = Google sign-in off.
GOOGLE_CLIENT_ID=

# ── Premium (off by default: everyone gets Pro as a founding beta) ──
# PREMIUM_ENABLED=false
# FREE_DEBATES_PER_WEEK=1
# PRICE_MONTHLY_INR=149
# PRICE_YEARLY_INR=999
# Razorpay → Dashboard → Account & Settings → API keys; Subscriptions → Plans (one monthly, one yearly);
# Webhooks → URL https://<api>/api/billing/webhook, events subscription.*, a secret you choose.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_MONTHLY=plan_...
# RAZORPAY_PLAN_YEARLY=plan_...

# ── Streak reminder emails (optional) ─────────────────────────────────────────
# Sent once a day from REMINDER_HOUR (APP_TIMEZONE) to learners who practised
# yesterday but not today. Needs SMTP above. Cap stays under your provider's
# daily limit (Gmail ≈ 500/day). WEB_URL is used for links (defaults to the
# first CORS_ORIGIN).
REMINDERS_ENABLED=true
REMINDER_HOUR=19
REMINDER_DAILY_CAP=400
# WEB_URL=https://scenescribe.in
