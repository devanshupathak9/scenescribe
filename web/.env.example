# Backend origin — no trailing slash, no /api suffix. Inlined at BUILD time,
# so changing it on Vercel needs a redeploy.
# Dev:  http://localhost:3001   (or leave unset to use the Vite proxy)
# Prod: https://your-backend.up.railway.app
VITE_API_URL=http://localhost:3001

# Google sign-in. OAuth 2.0 Client ID (type "Web application") from Google Cloud
# Console → APIs & Services → Credentials. Add your Vercel domain and
# http://localhost:5173 under "Authorised JavaScript origins".
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
